<Window x:Class="Drm.Agent.Tray.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DRM Agent" Height="420" Width="680" MinHeight="420" MinWidth="640"
        Background="#F7F8FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="DRM Agent" FontSize="22" FontWeight="SemiBold" Foreground="#111827" />
            <TextBlock Text="Protect PDF files into managed encrypted containers." Margin="0,4,0,0" Foreground="#4B5563" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Server URL" Foreground="#374151" />
            <TextBox x:Name="ServerUrlBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" Text="http://localhost:5188" />

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Tenant ID" Foreground="#374151" />
            <TextBox x:Name="TenantIdBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="User ID" Foreground="#374151" />
            <TextBox x:Name="UserIdBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="PDF File" Foreground="#374151" />
            <TextBox x:Name="SourcePathBox" Grid.Row="6" Grid.Column="1" Height="32" Margin="0,0,8,0"
                     VerticalContentAlignment="Center" />
            <Button Grid.Row="6" Grid.Column="2" Width="92" Height="32" Content="Browse" Click="BrowseButton_Click" />

            <CheckBox x:Name="DeleteOriginalBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                      Content="Delete original PDF after successful protection" Foreground="#374151" />

            <Button x:Name="ProtectButton" Grid.Row="10" Grid.Column="1" Width="128" Height="36"
                    HorizontalAlignment="Left" Content="Protect PDF" Click="ProtectButton_Click" />
        </Grid>

        <Border Grid.Row="3" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF" Padding="12">
            <TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap" Foreground="#111827" />
        </Border>
    </Grid>
</Window>
