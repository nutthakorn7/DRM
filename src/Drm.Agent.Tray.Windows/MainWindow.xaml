<Window x:Class="Drm.Agent.Tray.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DRM Agent" Height="1040" Width="760" MinHeight="980" MinWidth="700"
        Background="#F7F8FA"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragEnter"
        Drop="Window_Drop">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="DRM Agent" FontSize="22" FontWeight="SemiBold" Foreground="#111827" />
            <TextBlock Text="Protect files into managed encrypted containers." Margin="0,4,0,0" Foreground="#4B5563" />
            <Border Margin="0,16,0,0" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="🚀 Quick Send (recommended)" FontSize="14" FontWeight="SemiBold"
                               Foreground="#1f2937" />
                    <TextBlock Text="One drop, one email, one click. The recipient gets a verification link."
                               Foreground="#6B7280" Margin="0,2,0,8" TextWrapping="Wrap" FontSize="11" />
                    <Border x:Name="QuickDropZone" Background="#FAFAFA" BorderBrush="#D1D5DB"
                            BorderThickness="2" CornerRadius="6" Padding="14" AllowDrop="True"
                            DragEnter="QuickDropZone_DragEnter"
                            DragLeave="QuickDropZone_DragLeave"
                            DragOver="QuickDropZone_DragEnter"
                            Drop="QuickDropZone_Drop">
                        <StackPanel>
                            <TextBlock Text="Drop file here, or click Browse below" Foreground="#9CA3AF"
                                       FontSize="11" HorizontalAlignment="Center" />
                            <TextBlock x:Name="QuickDropFile" Foreground="#6f3a08" FontWeight="SemiBold"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Send to:" Foreground="#374151" VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBox x:Name="QuickRecipientBox" Width="280" Height="26"
                                 VerticalContentAlignment="Center" />
                        <Button x:Name="QuickBrowseButton" Content="Browse" Margin="8,0,0,0"
                                Padding="10,2" Click="QuickBrowseButton_Click" />
                        <Button x:Name="QuickSendButton" Content="Send protected file"
                                Margin="8,0,0,0" Padding="14,4" Background="#A45B13" Foreground="White"
                                FontWeight="SemiBold" BorderThickness="0"
                                Click="QuickSendButton_Click" />
                    </StackPanel>

                    <!--
                        Per-share permission picker (Stage 7). Collapsed
                        by default so "Quick send" stays one-drop /
                        one-email / one-click for the common case.
                        Power users expand to override the tenant's
                        default permission set + expiry per individual
                        share.  Checkboxes map 1:1 to Permission flag
                        bits on the wire; View is always granted.
                    -->
                    <Expander x:Name="QuickPermissionsExpander"
                              Header="Customize permissions for this recipient"
                              IsExpanded="False" Margin="0,10,0,0"
                              Foreground="#374151" FontSize="11">
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="4" Padding="12,8" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="View is always granted (recipient must open the file)."
                                           Foreground="#6B7280" FontSize="11" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="QuickAllowPrintBox"   Content="Allow print"
                                              Margin="0,0,16,0" FontSize="11" />
                                    <CheckBox x:Name="QuickAllowCopyBox"    Content="Allow copy text"
                                              Margin="0,0,16,0" FontSize="11" />
                                    <CheckBox x:Name="QuickAllowEditBox"    Content="Allow edit"
                                              Margin="0,0,16,0" FontSize="11" />
                                    <CheckBox x:Name="QuickAllowExportOriginalBox"
                                              Content="Allow download original (no DRM)"
                                              FontSize="11" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Access expires:" VerticalAlignment="Center"
                                               Foreground="#374151" FontSize="11" Margin="0,0,8,0" />
                                    <ComboBox x:Name="QuickExpiryDropdown" Width="160" FontSize="11"
                                              SelectedIndex="0">
                                        <ComboBoxItem Tag="168">In 7 days (default)</ComboBoxItem>
                                        <ComboBoxItem Tag="720">In 30 days</ComboBoxItem>
                                        <ComboBoxItem Tag="2160">In 90 days</ComboBoxItem>
                                        <ComboBoxItem Tag="8760">In 365 days (max)</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Foreground="#6B7280" FontSize="10" Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Text="Unchecked = denied. Defaults match a 'View only' policy — least privilege. Allow Download original is the DRM escape hatch — only enable for trusted internal use." />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <TextBlock x:Name="QuickResultText" Foreground="#047857" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Expander Header="Advanced (manual protect, integrations, status)" IsExpanded="False"
                      Margin="0,12,0,0" Foreground="#374151" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Server URL" Foreground="#374151" />
            <TextBox x:Name="ServerUrlBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" Text="http://localhost:5188" />

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Client API Key" Foreground="#374151" />
            <PasswordBox x:Name="ClientApiKeyBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                         VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Tenant ID" Foreground="#374151" />
            <TextBox x:Name="TenantIdBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="User ID" Foreground="#374151" />
            <TextBox x:Name="UserIdBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="Policy template ID" Foreground="#374151" />
            <TextBox x:Name="PolicyTemplateIdBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="Recipient user IDs" Foreground="#374151" />
            <TextBox x:Name="RecipientUserIdsBox" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="12" Grid.Column="0" VerticalAlignment="Center" Text="Recipient group IDs" Foreground="#374151" />
            <TextBox x:Name="RecipientGroupIdsBox" Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="14" Grid.Column="0" VerticalAlignment="Center" Text="Source file" Foreground="#374151" />
            <Border x:Name="DropZone"
                    Grid.Row="14"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Background="#FFFFFF"
                    BorderBrush="#D1D5DB"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="10,6"
                    AllowDrop="True"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    DragOver="DropZone_DragEnter"
                    Drop="DropZone_Drop">
                <Grid>
                    <TextBox x:Name="SourcePathBox" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" />
                    <TextBlock x:Name="DropZoneHint"
                               IsHitTestVisible="False"
                               Foreground="#9CA3AF"
                               VerticalAlignment="Center"
                               Text="Drag a file here, or click Browse →"
                               Margin="2,0,0,0" />
                </Grid>
            </Border>
            <Button Grid.Row="14" Grid.Column="2" Width="92" Height="32" Content="Browse" Click="BrowseButton_Click" />

            <CheckBox x:Name="DeleteOriginalBox" Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2"
                      Content="Delete original file after successful protection" Foreground="#374151" />

            <Button x:Name="ProtectButton" Grid.Row="18" Grid.Column="1" Width="128" Height="36"
                    HorizontalAlignment="Left" Content="Protect file" Click="ProtectButton_Click" />
        </Grid>

        <Border Grid.Row="3" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF" Padding="12">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap" Foreground="#111827" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Box:" Foreground="#6B7280" Margin="0,0,6,0" />
                    <Ellipse x:Name="BoxStatusDot"
                             Width="10" Height="10"
                             Fill="#9CA3AF"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0" />
                    <TextBlock x:Name="BoxStatusText"
                               Text="Not checked"
                               Foreground="#374151"
                               VerticalAlignment="Center" />
                    <Button x:Name="CheckBoxStatusButton"
                            Content="Check"
                            Margin="14,0,0,0"
                            Padding="10,2"
                            Click="CheckBoxStatusButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Outlook:" Foreground="#6B7280" Margin="0,0,6,0" />
                    <Ellipse x:Name="OutlookStatusDot"
                             Width="10" Height="10"
                             Fill="#9CA3AF"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0" />
                    <TextBlock x:Name="OutlookStatusText"
                               Text="Not checked"
                               Foreground="#374151"
                               VerticalAlignment="Center" />
                    <Button x:Name="CheckOutlookStatusButton"
                            Content="Check"
                            Margin="14,0,0,0"
                            Padding="10,2"
                            Click="CheckOutlookStatusButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Folder watcher:" Foreground="#6B7280" Margin="0,0,6,0" />
                    <Ellipse x:Name="FolderWatcherDot"
                             Width="10" Height="10"
                             Fill="#9CA3AF"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0" />
                    <TextBlock x:Name="FolderWatcherText"
                               Text="Not checked"
                               Foreground="#374151"
                               VerticalAlignment="Center" />
                    <Button x:Name="CheckFolderWatcherButton"
                            Content="Check"
                            Margin="14,0,0,0"
                            Padding="10,2"
                            Click="CheckFolderWatcherButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="License:" Foreground="#6B7280" Margin="0,0,6,0" />
                    <TextBlock x:Name="LicenseTierText"
                               Text="Not checked"
                               Foreground="#374151"
                               VerticalAlignment="Center" />
                    <Button x:Name="CheckLicenseButton"
                            Content="Check"
                            Margin="14,0,0,0"
                            Padding="10,2"
                            Click="CheckLicenseButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Default tag:" Foreground="#6B7280" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="DefaultTagBox" Width="220" Height="22"
                             VerticalContentAlignment="Center" />
                </StackPanel>
                <Border BorderBrush="#D1D5DB" BorderThickness="1" Background="#F9FAFB"
                        Padding="10" Margin="0,10,0,0" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Transparent protect (extension preserved)"
                                   FontWeight="SemiBold" Foreground="#374151" />
                        <TextBlock Text="Drop a file onto the box below to append a DRM trailer. The file remains openable in its native application."
                                   Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <Border x:Name="TransparentDropZone"
                                Background="#FFFFFF"
                                BorderBrush="#D1D5DB"
                                BorderThickness="2"
                                CornerRadius="6"
                                Padding="12"
                                AllowDrop="True"
                                MinHeight="44"
                                DragEnter="TransparentDropZone_DragEnter"
                                DragLeave="TransparentDropZone_DragLeave"
                                DragOver="TransparentDropZone_DragEnter"
                                Drop="TransparentDropZone_Drop">
                            <TextBlock x:Name="TransparentDropHint"
                                       Text="Drop file here to transparent-protect (output: same name + same extension, with DRM trailer appended)"
                                       Foreground="#9CA3AF"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#D1D5DB" BorderThickness="1" Background="#F9FAFB"
                        Padding="10" Margin="0,10,0,0" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Create secure container (folder)"
                                   FontWeight="SemiBold" Foreground="#374151" />
                        <TextBlock Text="3-step wizard: ① Drop a folder → ② Set passphrase → ③ Click Create."
                                   Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,4" FontSize="11" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border x:Name="WizStep1Dot" Background="#A45B13" Width="22" Height="22" CornerRadius="11">
                                <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Drop folder" Margin="6,0,12,0" VerticalAlignment="Center" Foreground="#374151" />
                            <Border x:Name="WizStep2Dot" Background="#9CA3AF" Width="22" Height="22" CornerRadius="11">
                                <TextBlock Text="2" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Set passphrase" Margin="6,0,12,0" VerticalAlignment="Center" Foreground="#374151" />
                            <Border x:Name="WizStep3Dot" Background="#9CA3AF" Width="22" Height="22" CornerRadius="11">
                                <TextBlock Text="3" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Create" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#374151" />
                        </StackPanel>
                        <Border x:Name="ContainerDropZone"
                                Background="#FFFFFF"
                                BorderBrush="#D1D5DB"
                                BorderThickness="2"
                                CornerRadius="6"
                                Padding="12"
                                AllowDrop="True"
                                MinHeight="44"
                                DragEnter="ContainerDropZone_DragEnter"
                                DragLeave="ContainerDropZone_DragLeave"
                                DragOver="ContainerDropZone_DragEnter"
                                Drop="ContainerDropZone_Drop">
                            <TextBlock x:Name="ContainerDropHint"
                                       Text="Drop a folder here to seal it into a .drmcontainer"
                                       Foreground="#9CA3AF"
                                       TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Container passphrase:" Foreground="#6B7280" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <PasswordBox x:Name="ContainerPassphraseBox" Width="240" Height="22" />
                            <!--
                                Seal folder button — Phase 5AS-folder-rclick.
                                When the agent is launched from Explorer's
                                folder right-click ("Protect folder with
                                zcrDRM"), the WiX entry passes the folder
                                via the protect-folder switch so the
                                drop-zone is pre-filled. The user just
                                types a passphrase and clicks this button;
                                no second drag-and-drop required. Drag-drop
                                still works for power users.
                            -->
                            <Button x:Name="SealFolderButton"
                                    Content="Seal folder"
                                    Margin="8,0,0,0"
                                    Padding="8,2,8,2"
                                    Click="SealFolderButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
