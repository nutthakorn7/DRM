<Window x:Class="Drm.Agent.Tray.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DRM Agent" Height="730" Width="720" MinHeight="700" MinWidth="680"
        Background="#F7F8FA"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragEnter"
        Drop="Window_Drop">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="DRM Agent" FontSize="22" FontWeight="SemiBold" Foreground="#111827" />
            <TextBlock Text="Protect files into managed encrypted containers." Margin="0,4,0,0" Foreground="#4B5563" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Server URL" Foreground="#374151" />
            <TextBox x:Name="ServerUrlBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" Text="http://localhost:5188" />

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Client API Key" Foreground="#374151" />
            <PasswordBox x:Name="ClientApiKeyBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                         VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Tenant ID" Foreground="#374151" />
            <TextBox x:Name="TenantIdBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="User ID" Foreground="#374151" />
            <TextBox x:Name="UserIdBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="Policy template ID" Foreground="#374151" />
            <TextBox x:Name="PolicyTemplateIdBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="Recipient user IDs" Foreground="#374151" />
            <TextBox x:Name="RecipientUserIdsBox" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="12" Grid.Column="0" VerticalAlignment="Center" Text="Recipient group IDs" Foreground="#374151" />
            <TextBox x:Name="RecipientGroupIdsBox" Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="14" Grid.Column="0" VerticalAlignment="Center" Text="Source file" Foreground="#374151" />
            <Border x:Name="DropZone"
                    Grid.Row="14"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Background="#FFFFFF"
                    BorderBrush="#D1D5DB"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="10,6"
                    AllowDrop="True"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    DragOver="DropZone_DragEnter"
                    Drop="DropZone_Drop">
                <Grid>
                    <TextBox x:Name="SourcePathBox" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" />
                    <TextBlock x:Name="DropZoneHint"
                               IsHitTestVisible="False"
                               Foreground="#9CA3AF"
                               VerticalAlignment="Center"
                               Text="Drag a file here, or click Browse →"
                               Margin="2,0,0,0" />
                </Grid>
            </Border>
            <Button Grid.Row="14" Grid.Column="2" Width="92" Height="32" Content="Browse" Click="BrowseButton_Click" />

            <CheckBox x:Name="DeleteOriginalBox" Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2"
                      Content="Delete original file after successful protection" Foreground="#374151" />

            <Button x:Name="ProtectButton" Grid.Row="18" Grid.Column="1" Width="128" Height="36"
                    HorizontalAlignment="Left" Content="Protect file" Click="ProtectButton_Click" />
        </Grid>

        <Border Grid.Row="3" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF" Padding="12">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap" Foreground="#111827" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Box:" Foreground="#6B7280" Margin="0,0,6,0" />
                    <Ellipse x:Name="BoxStatusDot"
                             Width="10" Height="10"
                             Fill="#9CA3AF"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0" />
                    <TextBlock x:Name="BoxStatusText"
                               Text="Not checked"
                               Foreground="#374151"
                               VerticalAlignment="Center" />
                    <Button x:Name="CheckBoxStatusButton"
                            Content="Check"
                            Margin="14,0,0,0"
                            Padding="10,2"
                            Click="CheckBoxStatusButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Outlook:" Foreground="#6B7280" Margin="0,0,6,0" />
                    <Ellipse x:Name="OutlookStatusDot"
                             Width="10" Height="10"
                             Fill="#9CA3AF"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0" />
                    <TextBlock x:Name="OutlookStatusText"
                               Text="Not checked"
                               Foreground="#374151"
                               VerticalAlignment="Center" />
                    <Button x:Name="CheckOutlookStatusButton"
                            Content="Check"
                            Margin="14,0,0,0"
                            Padding="10,2"
                            Click="CheckOutlookStatusButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="License:" Foreground="#6B7280" Margin="0,0,6,0" />
                    <TextBlock x:Name="LicenseTierText"
                               Text="Not checked"
                               Foreground="#374151"
                               VerticalAlignment="Center" />
                    <Button x:Name="CheckLicenseButton"
                            Content="Check"
                            Margin="14,0,0,0"
                            Padding="10,2"
                            Click="CheckLicenseButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Default tag:" Foreground="#6B7280" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="DefaultTagBox" Width="220" Height="22"
                             VerticalContentAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
