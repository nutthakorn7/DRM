<Window x:Class="Drm.Agent.Tray.Windows.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to zcrDRM" Height="380" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F7F8FA" SizeToContent="Manual">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hero / brand -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="zcrDRM" FontSize="28" FontWeight="SemiBold" Foreground="#0F766E" />
            <TextBlock Text="Encrypt · Audit · Revoke" FontSize="12" Foreground="#6B7280"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- Headline -->
        <TextBlock Grid.Row="1" Margin="0,24,0,4" FontSize="16" FontWeight="SemiBold"
                   Foreground="#111827" Text="Let's get you signed in" />

        <TextBlock Grid.Row="2" Foreground="#4B5563" TextWrapping="Wrap" FontSize="12"
                   Text="Enter your work email. We'll connect this machine to your zcrDRM account so right-click-protect just works." />

        <!-- Email entry -->
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="Work email" FontWeight="SemiBold" Foreground="#374151" FontSize="12" />
            <TextBox x:Name="EmailBox" Margin="0,4,0,0" Height="32"
                     VerticalContentAlignment="Center" Padding="8,0,0,0" FontSize="14"
                     KeyDown="EmailBox_KeyDown" />
        </StackPanel>

        <!-- Inline status / error display -->
        <Border x:Name="StatusBox" Grid.Row="4" Margin="0,12,0,0" Padding="12,8"
                CornerRadius="4" Background="#FEF3C7" BorderBrush="#FBBF24"
                BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" Foreground="#92400E" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- Action row -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <Button x:Name="CancelButton" Content="Skip for now" Padding="14,6" Margin="0,0,8,0"
                    Click="CancelButton_Click" Background="Transparent" BorderBrush="#D1D5DB"
                    Foreground="#374151" />
            <Button x:Name="SignInButton" Content="Sign in" Padding="20,6"
                    Background="#0F766E" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Click="SignInButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
