<Window x:Class="Drm.Viewer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DRM Protected Viewer"
        Width="1100"
        Height="780"
        MinWidth="920"
        MinHeight="640"
        Background="#111827"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragEnter"
        Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F9FAFB" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="10" />
                <RowDefinition Height="32" />
                <RowDefinition Height="10" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server URL" VerticalAlignment="Center" Foreground="#374151" />
            <TextBox x:Name="ServerUrlBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="7"
                     VerticalContentAlignment="Center" Text="http://localhost:5188" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Client Key" VerticalAlignment="Center" Foreground="#374151" />
            <PasswordBox x:Name="ClientApiKeyBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="7"
                         VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="User ID" VerticalAlignment="Center" Foreground="#374151" />
            <TextBox x:Name="UserIdBox" Grid.Row="4" Grid.Column="1" Margin="0,0,12,0" VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="4" Grid.Column="2" Text="Device ID" VerticalAlignment="Center" Foreground="#374151" />
            <TextBox x:Name="DeviceIdBox" Grid.Row="4" Grid.Column="3" Margin="0,0,12,0" VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="4" Grid.Column="4" Text="File" VerticalAlignment="Center" Foreground="#374151" />
            <TextBox x:Name="ProtectedPathBox" Grid.Row="4" Grid.Column="5" Margin="0,0,8,0" VerticalContentAlignment="Center" />

            <Button Grid.Row="4" Grid.Column="6" Width="72" Height="28" Content="Browse" Click="BrowseButton_Click" />
            <Button x:Name="OpenButton" Grid.Row="4" Grid.Column="7" Width="80" Height="28" Content="Open" Click="OpenButton_Click" />
        </Grid>
        </Border>

        <DockPanel Grid.Row="1" Background="#1F2937" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <CheckBox x:Name="PrintWmEnabledBox"
                          Content="Print WM"
                          Foreground="#D1D5DB"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />
                <TextBox x:Name="PrintWmPatternBox"
                         Width="200"
                         Height="24"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         ToolTip="Print watermark pattern. Tokens: {user} {time} {file}" />
                <Button x:Name="CopyButton"
                        Width="70"
                        Height="28"
                        Margin="0,0,8,0"
                        Content="Copy"
                        IsEnabled="False"
                        Click="CopyButton_Click" />
                <Button x:Name="PrintButton"
                        Width="70"
                        Height="28"
                        Margin="0,0,8,0"
                        Content="Print"
                        IsEnabled="False"
                        Click="PrintButton_Click" />
                <Button x:Name="ExportButton"
                        Width="90"
                        Height="28"
                        Content="Export"
                        IsEnabled="False"
                        Click="ExportButton_Click" />
            </StackPanel>
            <TextBlock Text="Protected file"
                       DockPanel.Dock="Left"
                       Foreground="White"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="14,0" />
            <TextBlock x:Name="PermissionText"
                       Foreground="#D1D5DB"
                       VerticalAlignment="Center"
                       Margin="18,0" />
        </DockPanel>

        <Grid Grid.Row="2" Background="#111827">
            <WebBrowser x:Name="PdfHost" />
            <ItemsControl x:Name="WatermarkTileHost"
                          IsHitTestVisible="False"
                          Opacity="0.33">
                <ItemsControl.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="WatermarkOffset" X="0" Y="0" />
                    </TransformGroup>
                </ItemsControl.RenderTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid x:Name="WatermarkGrid" Rows="4" Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="-28" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="WatermarkText" Visibility="Collapsed" />
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="StatusText"
                   Background="#F3F4F6"
                   Foreground="#374151"
                   VerticalAlignment="Center"
                   Padding="10,0" />
    </Grid>
</Window>
