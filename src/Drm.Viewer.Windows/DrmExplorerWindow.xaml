<Window x:Class="Drm.Viewer.Windows.DrmExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DRM Explorer — Protected file browser"
        Width="980" Height="640" MinWidth="760" MinHeight="480"
        Background="#F9FAFB"
        ShowInTaskbar="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="DRM Explorer" FontSize="20" FontWeight="SemiBold" Foreground="#111827" />
            <TextBlock Text="  Browse every protected file your tenant has."
                       Foreground="#6B7280" VerticalAlignment="Center" Margin="6,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FilterBox" Height="28" VerticalContentAlignment="Center"
                     Margin="0,0,8,0"
                     TextChanged="FilterBox_TextChanged" />
            <Button x:Name="RefreshButton" Grid.Column="1" Width="92" Height="28"
                    Content="Refresh" Click="RefreshButton_Click" />
        </Grid>

        <DataGrid x:Name="FilesGrid" Grid.Row="2" Margin="0,10,0,0"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  Background="#FFFFFF" RowBackground="#FFFFFF"
                  AlternatingRowBackground="#F3F4F6"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File ID" Binding="{Binding FileId}" Width="220" />
                <DataGridTextColumn Header="Content type" Binding="{Binding ContentType}" Width="200" />
                <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}" Width="*" />
                <DataGridTextColumn Header="Owner" Binding="{Binding OwnerUserId}" Width="220" />
                <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresAtUtc}" Width="160" />
                <DataGridCheckBoxColumn Header="Revoked" Binding="{Binding Revoked}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#F3F4F6" Padding="10,4" Margin="0,8,0,0"
                BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Foreground="#374151"
                       Text="Click Refresh to load files." />
        </Border>
    </Grid>
</Window>
