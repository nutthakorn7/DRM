<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!--
      NU1903: CVE-2025-6965 (HIGH) in SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11, pulled transitively by
      Microsoft.EntityFrameworkCore.Sqlite. SQLite is dev/test-only here (production runs Postgres),
      so the deployed product is not exposed. No patched SQLitePCLRaw bundle exists yet (upstream fix
      is SQLite >= 3.50.2). Downgraded to a printed warning so it does not fail the build; every OTHER
      advisory still fails. REMOVE this once EF Sqlite ships a bundle with patched e_sqlite3.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
