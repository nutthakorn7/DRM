# Copy to .env, then fill values. Never commit .env.
#
# Generate fresh secrets with:
#   openssl rand -base64 32   # master key (DO NOT rotate after data written)
#   openssl rand -hex 32      # admin / client / trailer secrets
#   openssl rand -base64 24   # postgres password

# Public hostname Caddy obtains a Let's Encrypt cert for.
# Requires DNS A record pointing to this server + ports 80/443 reachable.
DOMAIN=drm.example.com

# Image tag to run. Default 'local' = whatever you just built.
# Set to a version like v1.1.0 once you start tagging releases for rollback.
DRM_IMAGE_TAG=local

# --- DRM secrets ---
# IMPORTANT: DRM_MASTER_KEY_BASE64 encrypts tenant wrapping keys at rest.
# Losing it means losing access to all encrypted data. Back it up to a
# secret manager (1Password / Vault / AWS Secrets Manager) immediately.
DRM_MASTER_KEY_BASE64=
DRM_ADMIN_API_KEY=
DRM_CLIENT_API_KEY=
DRM_TRAILER_SECRET=

# --- License (optional, defaults are fine for self-hosted) ---
DRM_LICENSE_TIERS=All
DRM_PAID_ENCRYPTERS=10

# --- Postgres ---
POSTGRES_DB=drm
POSTGRES_USER=drm
POSTGRES_PASSWORD=
