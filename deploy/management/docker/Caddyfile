# Caddyfile — production reverse proxy for drm-server.
# Caddy substitutes {$DOMAIN} from the DOMAIN env var on container start.

{$DOMAIN} {
    reverse_proxy drm-server:8080

    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output stdout
        format console
    }
}
