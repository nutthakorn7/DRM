{
  "Drm": {
    "Mode": "OnPrem",
    "KeyWrapping": {
      "MasterKeyBase64": "REPLACE_WITH_32_BYTE_BASE64_MASTER_KEY"
    },
    "Security": {
      "AdminApiKey": "REPLACE_WITH_ADMIN_API_KEY",
      "ClientApiKey": "REPLACE_WITH_CLIENT_API_KEY"
    },
    "Email": {
      "SmtpHost": "smtp.example.com",
      "SmtpPort": 587,
      "SmtpUseTls": true,
      "SmtpUsername": "noreply@example.com",
      "SmtpPassword": "REPLACE_WITH_SMTP_PASSWORD",
      "FromAddress": "noreply@example.com",
      "FromName": "DRM Security"
    }
  },
  "ConnectionStrings": {
    "DrmDb": "Data Source=/var/lib/drm-management/drm-server.db"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
