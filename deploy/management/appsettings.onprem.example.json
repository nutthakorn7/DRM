{
  "Drm": {
    "Mode": "OnPrem",
    "KeyWrapping": {
      "MasterKeyBase64": "REPLACE_WITH_32_BYTE_BASE64_MASTER_KEY"
    },
    "Security": {
      "AdminApiKey": "REPLACE_WITH_ADMIN_API_KEY",
      "ClientApiKey": "REPLACE_WITH_CLIENT_API_KEY"
    }
  },
  "ConnectionStrings": {
    "DrmDb": "Data Source=/var/lib/drm-management/drm-server.db"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
