<?xml version="1.0" encoding="UTF-8"?>
<!--
    zcrDRM Agent MSI installer (WiX 4).

    What this MSI does (the "easy to use ที่สุด" promise):
      1. Drops the self-contained .NET 10 win-x64 publish output of
         Drm.Agent.Tray.Windows + Drm.Viewer.Windows +
         Drm.Agent.Service.Windows into
         C:\Program Files\zcrDRM\.  No prerequisite runtime install
         required on the end-user machine.
      2. Bakes the production server URL (https://drm.zcr.ai) into
         HKLM\SOFTWARE\zcrDRM\ServerUrl so the agent does not require
         the end user to paste or even know the server URL. Optional MSI
         properties also provision ClientApiKey/TenantId/UserId/DeviceId
         and DeviceSecret.
      3. Registers the .drmx file association so double-clicking a
         protected file opens it in the zcrDRM viewer.
      4. Registers a "Protect CAD file (internal)" right-click context menu
         that launches the internal CAD encryption flow.
      5. Installs and starts the Windows service that reports AD posture
         heartbeats for device trust.
      6. Adds a Start Menu shortcut.

    On uninstall every registry key declared below comes out too — the
    Windows Installer engine handles that automatically because each
    `RegistryValue` is the KeyPath of its component.

    Build it with `deploy\windows-msi\build-msi.ps1` on a Windows
    machine that has the .NET 10 SDK plus the WiX 4 tool installed
    via `dotnet tool install -g wix`. The script publishes the tray
    and viewer self-contained for win-x64 into publish\agent\, then
    invokes `wix build Product.wxs`.

    The CI windows-latest job (.github/workflows/ci.yml) does all of
    this and then runs msiexec /i and asserts the registry/files.
-->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
      UpgradeCode MUST remain stable across versions — it's how
      Windows recognises future MSI builds as "the same product"
      and triggers MajorUpgrade behaviour. Never regenerate this.
  -->
  <Package
      Name="zcrDRM Agent"
      Manufacturer="CyberDefense Co."
      Version="1.6.1.0"
      UpgradeCode="1DEDF094-CEFC-4BB7-988B-E4AB05C6CAFE"
      InstallerVersion="500"
      Scope="perMachine"
      Compressed="yes">

    <SummaryInformation
        Description="zcrDRM Agent — encrypt, audit, revoke documents from Windows"
        Manufacturer="CyberDefense Co." />

    <!--
        Side-by-side install of an older zcrDRM Agent is never useful.
        Block downgrades; silently upgrade earlier versions.
    -->
    <MajorUpgrade
        DowngradeErrorMessage="A newer version of zcrDRM Agent is already installed. Uninstall it before installing this older version."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="SERVERURL" Value="https://drm.zcr.ai" />
    <Property Id="CLIENTAPIKEY" Secure="yes" Hidden="yes" />
    <Property Id="TENANTID" Secure="yes" />
    <Property Id="USERID" Secure="yes" />
    <Property Id="DEVICEID" Secure="yes" />
    <Property Id="DEVICESECRET" Secure="yes" Hidden="yes" />

    <!--
        Install layout. ProgramFiles64Folder is the 64-bit
        C:\Program Files\.  All of zcrDRM lands under
        C:\Program Files\zcrDRM\ — including the viewer; the tray and
        viewer ship side-by-side so right-click "Protect" can shell out
        to the tray and double-click .drmx can shell out to the viewer
        with no PATH manipulation.
    -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="zcrDRM" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ZcrDrmProgramsFolder" Name="zcrDRM" />
    </StandardDirectory>

    <!--
        File payload is auto-harvested by the AgentBinaries component
        group defined in the Fragment below.  Splitting it out into a
        Fragment is a WiX 4 requirement: `<ComponentGroup>` with a
        `Source` attribute and bulk `<Files>` only works at Fragment
        scope, not as a direct child of `<Package>`.
    -->

    <!--
        Server URL baked in.  The tray app reads
        HKLM\SOFTWARE\zcrDRM\ServerUrl at startup and pre-fills the
        Server URL textbox.  Single source of truth — change the value
        once here for OEM builds (e.g. a tenant whose private cloud
        runs at https://drm.acme.example) without rebuilding the agent.
    -->
    <Component Id="ServerConfigRegistry" Directory="INSTALLFOLDER" Guid="*">
      <RegistryKey Root="HKLM" Key="SOFTWARE\zcrDRM">
        <RegistryValue Name="ServerUrl" Type="string" Value="[SERVERURL]" KeyPath="yes" />
        <RegistryValue Name="ClientApiKey" Type="string" Value="[CLIENTAPIKEY]" />
        <RegistryValue Name="TenantId" Type="string" Value="[TENANTID]" />
        <RegistryValue Name="UserId" Type="string" Value="[USERID]" />
        <RegistryValue Name="DeviceId" Type="string" Value="[DEVICEID]" />
        <!-- DeviceSecret moved to the ACL'd HKLM\SOFTWARE\zcrDRM\Secure key
             below (PR #51 hardening) so non-admin Users cannot read it.
             The rest of this key stays Users-readable because the tray app
             reads ServerUrl from it in the logged-on user's context. -->
        <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
        <RegistryValue Name="Version" Type="string" Value="1.6.1.0" />
      </RegistryKey>
    </Component>

    <!--
        PR #51 hardening: the per-device signing secret lives in its own
        ACL'd key so a non-admin local user cannot read it (the default
        HKLM\SOFTWARE ACL grants Users:Read, which would otherwise let any
        local user run `reg query` and forge device signatures offline).

        util:PermissionEx sets a protected DACL of exactly LocalSystem +
        Administrators (full control) — inheritance is broken, so the
        inherited Users:Read ACE no longer applies. LocalSystem is the
        account the zcrDRMAgent service runs as (it reads + signs);
        Administrators covers the elevated installer doing install/uninstall.
    -->
    <Component Id="DeviceSecretRegistry" Directory="INSTALLFOLDER" Guid="*">
      <RegistryKey Root="HKLM" Key="SOFTWARE\zcrDRM\Secure" ForceCreateOnInstall="yes">
        <RegistryValue Name="DeviceSecret" Type="string" Value="[DEVICESECRET]" KeyPath="yes" />
        <util:PermissionEx User="SYSTEM" GenericAll="yes" />
        <util:PermissionEx User="Administrators" GenericAll="yes" />
      </RegistryKey>
    </Component>

    <!--
        .drmx file association.  Writes to HKCR (which Windows maps to
        HKLM\SOFTWARE\Classes for per-machine MSIs) so every user on
        the box gets the association.

        Quoting note: `&quot;` is the literal " character.  The final
        command line that lands in the registry is, conceptually:
            "[INSTALLFOLDER]Drm.Viewer.Windows.exe" [dash][dash]open "%1"
        with %1 being the path Explorer hands us when the user
        double-clicks a .drmx file. (XML comments can't contain a
        double-hyphen, so the prose says "[dash][dash]open" where the
        actual registry value uses two literal ASCII dashes.)
    -->
    <Component Id="DrmxFileAssociation" Directory="INSTALLFOLDER" Guid="*">
      <RegistryKey Root="HKCR" Key=".drmx">
        <RegistryValue Type="string" Value="zcrDRM.ProtectedFile.1" KeyPath="yes" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="zcrDRM.ProtectedFile.1">
        <RegistryValue Type="string" Value="zcrDRM Protected File" />
        <RegistryValue Name="FriendlyTypeName" Type="string" Value="zcrDRM Protected File" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="zcrDRM.ProtectedFile.1\DefaultIcon">
        <RegistryValue Type="string" Value="[INSTALLFOLDER]Drm.Viewer.Windows.exe,0" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="zcrDRM.ProtectedFile.1\shell\open\command">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]Drm.Viewer.Windows.exe&quot; --open &quot;%1&quot;" />
      </RegistryKey>
    </Component>

    <!--
        .drmcontainer association — same shape, separate ProgID so
        Explorer shows a distinct icon/label if we ever ship one.
    -->
    <Component Id="DrmContainerFileAssociation" Directory="INSTALLFOLDER" Guid="*">
      <RegistryKey Root="HKCR" Key=".drmcontainer">
        <RegistryValue Type="string" Value="zcrDRM.SecureContainer.1" KeyPath="yes" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="zcrDRM.SecureContainer.1">
        <RegistryValue Type="string" Value="zcrDRM Secure Container" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="zcrDRM.SecureContainer.1\shell\open\command">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]Drm.Viewer.Windows.exe&quot; --open &quot;%1&quot;" />
      </RegistryKey>
    </Component>

    <!--
        Right-click "Protect CAD file (internal)" on files. The tray enforces
        the CAD extension allowlist and no longer exposes external share-link
        or folder/passphrase flows for the customer demo.
    -->
    <Component Id="ProtectShellMenu" Directory="INSTALLFOLDER" Guid="*">
      <RegistryKey Root="HKCR" Key="*\shell\zcrDRMProtect">
        <RegistryValue Name="MUIVerb" Type="string" Value="Protect CAD file (internal)" KeyPath="yes" />
        <RegistryValue Name="Icon" Type="string" Value="imageres.dll,-78" />
      </RegistryKey>
      <RegistryKey Root="HKCR" Key="*\shell\zcrDRMProtect\command">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]Drm.Agent.Tray.Windows.exe&quot; --quick-protect &quot;%1&quot;" />
      </RegistryKey>
    </Component>

    <Component Id="AgentPostureService" Directory="INSTALLFOLDER" Guid="*">
      <File Id="AgentPostureServiceExe"
            Source="publish\service\Drm.Agent.Service.Windows.exe"
            KeyPath="yes" />
      <ServiceInstall Id="AgentPostureServiceInstall"
                      Name="zcrDRMAgent"
                      DisplayName="zcrDRM Agent"
                      Description="Reports zcrDRM device posture and processes remote commands."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem" />
      <ServiceControl Id="AgentPostureServiceControl"
                      Name="zcrDRMAgent"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <!--
        Start Menu shortcut.  The HKCU RegistryValue is required by
        Windows Installer to be the component's KeyPath — Shortcut
        elements don't qualify as a KeyPath, and per-user shortcuts
        installed by a per-machine MSI need a per-user registry
        breadcrumb for the engine to track them per-user.
    -->
    <Component Id="TrayStartMenuShortcut" Directory="ZcrDrmProgramsFolder" Guid="*">
      <Shortcut Id="TrayShortcut"
                Name="zcrDRM Agent"
                Description="zcrDRM tray — protect, audit, revoke documents"
                Target="[INSTALLFOLDER]Drm.Agent.Tray.Windows.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="ViewerShortcut"
                Name="zcrDRM Viewer"
                Description="Open a zcrDRM-protected file"
                Target="[INSTALLFOLDER]Drm.Viewer.Windows.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveZcrDrmProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\zcrDRM\Installed"
                     Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!--
        Single feature, no install-time picker.  The end user clicks
        Next-Next-Finish and gets internal CAD protection, .drmx viewer,
        auto-start, Start Menu. Power users can still uninstall via Add/Remove Programs.
    -->
    <Feature Id="Main" Title="zcrDRM Agent" Level="1">
      <ComponentGroupRef Id="AgentBinaries" />
      <ComponentRef Id="ServerConfigRegistry" />
      <ComponentRef Id="DeviceSecretRegistry" />
      <ComponentRef Id="DrmxFileAssociation" />
      <ComponentRef Id="DrmContainerFileAssociation" />
      <ComponentRef Id="ProtectShellMenu" />
      <ComponentRef Id="AgentPostureService" />
      <ComponentRef Id="TrayStartMenuShortcut" />
    </Feature>

  </Package>

  <!--
      Bulk-harvested file payload. Lives in a Fragment because
      `<ComponentGroup Source="...">` + `<Files Include="...">` is
      Fragment-scoped in WiX 4. The Feature inside <Package> above
      references this via <ComponentGroupRef Id="AgentBinaries" />.

      Source attribute is the base directory; `<Files Include="**\*">`
      then matches every file in publish\agent\ and every subdirectory,
      producing one Component per file with WiX-generated stable IDs.
      Directory subtree (e.g. runtimes\win-x64\native\) is preserved
      into INSTALLFOLDER, so WebView2 native deps land where the
      viewer expects them. build-msi.ps1 moves the service EXE to
      publish\service\ first so its File element can own the Windows
      service install without duplicating that file in AgentBinaries.
  -->
  <Fragment>
    <ComponentGroup Id="AgentBinaries" Directory="INSTALLFOLDER" Source="publish\agent">
      <Files Include="**\*" />
    </ComponentGroup>
  </Fragment>
</Wix>
